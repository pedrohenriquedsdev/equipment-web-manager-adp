﻿@{
    Layout = "_Layout";
    ViewBag.Titulo = "";
}

<section class="hero">
    <span class="hero-eyebrow">Sistema de Gestão</span>
    <h1 class="hero-title">
        Gerencie com<br>
        <strong>elegância e precisão</strong>
    </h1>
    <p class="hero-subtitle">
        Uma plataforma pensada para simplificar seus processos, centralizar informações e dar clareza a cada decisão.
    </p>
    <div class="hero-actions">
        <a href="#" class="btn-primary">Começar agora</a>
    </div>
</section>

<div class="stats-strip">
    <div class="stat-item">
        <span class="stat-number">248</span>
        <span class="stat-label">Registros</span>
    </div>
    <div class="stat-item">
        <span class="stat-number">12</span>
        <span class="stat-label">Categorias</span>
    </div>
    <div class="stat-item">
        <span class="stat-number">99%</span>
        <span class="stat-label">Disponibilidade</span>
    </div>
    <div class="stat-item">
        <span class="stat-number">3x</span>
        <span class="stat-label">Mais rápido</span>
    </div>
</div>

<hr class="divider-gold" />

<section class="features-grid">
    <div class="feature-card">
        <h3 class="feature-title">Cadastro Simples</h3>
        <p class="feature-desc">Adicione e edite registros com um fluxo intuitivo, sem complexidade desnecessária.</p>
    </div>
    <div class="feature-card">
        <h3 class="feature-title">Filtros Precisos</h3>
        <p class="feature-desc">Encontre exatamente o que precisa com filtros rápidos e listagens organizadas.</p>
    </div>
    <div class="feature-card">
        <h3 class="feature-title">Visão Clara</h3>
        <p class="feature-desc">Acompanhe indicadores e tome decisões com dados sempre atualizados e acessíveis.</p>
    </div>
</section>
